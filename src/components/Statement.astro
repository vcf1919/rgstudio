---
import Label from './Label.astro';
import { site } from '../lib/site';
// "*word" marks a keyword (orange). Words are rendered here so the full text is in the HTML.
const words = site.statement.split(' ').map((w) => (w.startsWith('*') ? { t: w.slice(1), acc: true } : { t: w, acc: false }));
---
<section class="statement" aria-labelledby="estudio-t">
  <Label left="(01) Estudio" right={site.brand} />
  <h2 class="sr" id="estudio-t">Estudio</h2>
  <p class="d" data-reveal-words>
    {words.map((w, i) => <Fragment><span data-w class:list={{ acc: w.acc }}>{w.t}</span>{i < words.length - 1 && ' '}</Fragment>)}
  </p>
</section>

<style>
  .statement{padding:18vh var(--pad) 16vh}
  .statement p{font-size:clamp(34px,5.6vw,84px);line-height:1.02;max-width:17ch}
  .statement span{color:var(--faint);transition:color .4s var(--ease)}
  .statement span:global(.on){color:var(--ink)}
  .statement span.acc:global(.on){color:var(--acc)}
  @media (prefers-reduced-motion:reduce){
    .statement span{color:var(--ink);transition:none}
    .statement span.acc{color:var(--acc)}
  }
</style>

<script>
  import { onPage } from '../lib/lifecycle';
  import { init } from '../effects/reveal-words';
  onPage((doc) => {
    const el = doc.querySelector<HTMLElement>('[data-reveal-words]');
    if (el) return init(el).destroy;
  });
</script>
