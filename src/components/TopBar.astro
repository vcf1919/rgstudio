---
import { site, whatsappUrl } from '../lib/site';
---
<header class="bar">
  <a class="logo" href="/" aria-label={`${site.brand}, inicio`}>{site.brand}<i aria-hidden="true"></i></a>
  <a class="pill" href={whatsappUrl} target="_blank" rel="noopener">{site.hero.cta}</a>
</header>
<style>
  .bar{display:flex;justify-content:space-between;align-items:center;padding:var(--pad)}
  .logo{font-size:16px;font-weight:600;letter-spacing:-.03em;display:flex;align-items:center;gap:8px}
  .logo i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--acc);margin-left:2px}
  .pill{font-size:14px;font-weight:500;border:1px solid var(--ink);border-radius:999px;padding:9px 16px;transition:background .35s var(--ease),color .35s var(--ease)}
  .pill:hover{background:var(--ink);color:var(--bg)}
</style>
