---
import { Image } from 'astro:assets';
import Label from './Label.astro';
import { getProjects, kindLabel } from '../lib/content';
const projects = await getProjects();
const allConcepts = projects.every((p) => p.data.kind === 'concepto');
---
<section class="works" id="trabajos" data-works aria-labelledby="trabajos-t">
  <Label left="(03) Trabajos" right={allConcepts ? 'Conceptos' : `${projects.length} proyectos`} />
  <h2 class="sr" id="trabajos-t">Trabajos</h2>
  <ul role="list">
    {projects.map((p) => (
      <li>
        <a class="work" href={`/trabajos/${p.id}/`} data-slug={p.id}>
          <h3 class="d"><span class="ri"><span>{p.data.title}</span></span></h3>
          <span class="meta mono">{p.data.sector}<br />{p.data.year}<span class="sr"> · {kindLabel(p.data.kind)}</span></span>
          <Image class="thumb" data-thumb src={p.data.cover} alt="" widths={[400, 800]} sizes="calc(100vw - 36px)" loading="lazy" />
        </a>
      </li>
    ))}
  </ul>
  <div class="preview" data-preview aria-hidden="true">
    {projects.map((p) => (
      <div data-layer={p.id}><Image src={p.data.cover} alt="" width={330} densities={[1, 2]} loading="lazy" /></div>
    ))}
  </div>
</section>

<style>
  .works{padding:10vh var(--pad) 18vh}
  ul{list-style:none}
  .work{display:grid;grid-template-columns:1fr auto;align-items:baseline;gap:16px;padding:20px 0;border-top:1px solid var(--line);cursor:pointer}
  li:last-child .work{border-bottom:1px solid var(--line)}
  h3{font-size:clamp(34px,6vw,92px);line-height:.95;transition:transform .6s var(--ease),color .4s}
  .meta{color:var(--mute);text-align:right}
  @media (hover:hover){
    ul:hover .work h3{color:#CFCAC1}
    ul .work:hover h3,ul .work:focus-visible h3{color:var(--ink);transform:translateX(14px)}
  }
  .thumb{display:none}
  @media (pointer:coarse){.thumb{display:block;grid-column:1/-1;width:100%;height:46vw;object-fit:cover;border-radius:8px;margin-top:10px}}
  .preview{position:fixed;left:0;top:0;z-index:20;width:300px;height:380px;margin:-190px 0 0 -150px;border-radius:10px;pointer-events:none;overflow:hidden;transform:scale(0)}
  .preview div{position:absolute;inset:-10%;transition:opacity .4s;opacity:0}
  .preview img{width:100%;height:100%;object-fit:cover}
  @media (pointer:coarse){.preview{display:none}}
</style>

<script>
  import { onPage } from '../lib/lifecycle';
  import { init } from '../effects/hover-preview';
  onPage((doc) => {
    const el = doc.querySelector<HTMLElement>('[data-works]');
    const pv = el?.querySelector<HTMLElement>('[data-preview]');
    if (el && pv) return init(el, pv).destroy;
  });
</script>
