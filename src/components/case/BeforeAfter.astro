---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { before: { src: ImageMetadata; alt: string }; after: { src: ImageMetadata; alt: string } }
const { before, after } = Astro.props;
const sizes = '(min-width: 1100px) 1100px, calc(100vw - 36px)';
---
<figure class="ba" data-before-after style="--x:50%">
  <Image class="img" src={before.src} alt={before.alt} widths={[600, 1100, 1600]} sizes={sizes} loading="lazy" />
  <div class="after"><Image class="img" src={after.src} alt={after.alt} widths={[600, 1100, 1600]} sizes={sizes} loading="lazy" /></div>
  <span class="tag mono l">Antes</span><span class="tag mono r">Después</span>
  <span class="handle" aria-hidden="true"><b></b></span>
  <label class="sr" for="ba-range">Comparar antes y después</label>
  <input id="ba-range" type="range" min="0" max="100" step="1" value="50" />
</figure>
<style>
  .ba{position:relative;border-radius:14px;overflow:hidden;border:1px solid var(--line);touch-action:pan-y;user-select:none;cursor:ew-resize;aspect-ratio:16/10;background:#fff}
  .img{width:100%;height:100%;object-fit:cover;object-position:top;pointer-events:none}
  .after{position:absolute;inset:0;clip-path:inset(0 0 0 var(--x))}
  .tag{position:absolute;top:14px;background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:6px 10px;color:var(--ink)}
  .l{left:14px} .r{right:14px}
  .handle{position:absolute;top:0;bottom:0;left:var(--x);width:1px;background:var(--ink);pointer-events:none}
  .handle b{position:absolute;top:50%;left:50%;width:44px;height:44px;margin:-22px 0 0 -22px;border-radius:50%;background:var(--ink);box-shadow:0 0 0 4px var(--bg)}
  .handle b::before{content:"‹ ›";position:absolute;inset:0;display:grid;place-items:center;color:var(--bg);font:500 15px var(--sans);letter-spacing:.1em}
  input{position:absolute;left:0;right:0;bottom:0;width:100%;opacity:0;height:24px;cursor:ew-resize}
  .ba:focus-within{outline:2px solid var(--acc);outline-offset:3px}
</style>
<script>
  import { onPage } from '../../lib/lifecycle';
  import { init } from '../../effects/before-after';
  onPage((doc) => [...doc.querySelectorAll<HTMLElement>('[data-before-after]')].map((el) => init(el).destroy));
</script>
