---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { site, whatsappUrl } from '../lib/site';
---
<Base>
  <main id="main">
    <Hero />
    <!-- Paso 3: Estudio → Proceso → Trabajos → Contacto -->
    <section class="todo" id="contacto">
      <div class="label mono"><span>(—) Próximamente</span><span>Paso 3</span></div>
      <p>Siguientes secciones en construcción. Mientras tanto: <a href={whatsappUrl}>WhatsApp</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </section>
  </main>
</Base>
<style>
  .todo{padding:18vh var(--pad);min-height:60svh}
  .todo p{font-size:clamp(18px,2vw,24px);max-width:40ch;line-height:1.4}
  .todo a{text-decoration:underline;text-underline-offset:3px}
</style>
