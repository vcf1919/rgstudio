---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Label from '../../components/Label.astro';
import Footer from '../../components/Footer.astro';
import BeforeAfter from '../../components/case/BeforeAfter.astro';
import { getProjects, kindLabel } from '../../lib/content';
import { whatsappUrl } from '../../lib/site';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((p, i) => ({ params: { slug: p.id }, props: { project: p, next: projects[(i + 1) % projects.length] } }));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const d = project.data;
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={d.title} description={d.summary} type="article">
  <TopBar />
  <main id="main" class="case">
    <header class="head">
      <a class="back mono" href="/#trabajos">← Trabajos</a>
      <h1 class="d"><span class="ri"><span>{d.title}</span></span></h1>
      <dl class="meta mono">
        <div><dt>Sector</dt><dd>{d.sector}</dd></div>
        <div><dt>Año</dt><dd>{d.year}</dd></div>
        <div><dt>Tipo</dt><dd><span class:list={['tag', d.kind]}>{kindLabel(d.kind)}</span></dd></div>
      </dl>
    </header>

    <Image class="cover" src={d.cover} alt={d.coverAlt} widths={[640, 1100, 1600, 2200]} sizes="calc(100vw - 2 * clamp(18px, 3.4vw, 44px))"
      loading="eager" fetchpriority="high" transition:name={`cover-${project.id}`} />

    <section class="intro">
      <Label left="(01) Proyecto" right={kindLabel(d.kind)} />
      <p class="lead">{d.summary}</p>
      {d.kind === 'concepto' && <p class="note mono">Negocio ficticio: es un concepto de diseño, no un cliente real.</p>}
    </section>

    <section class="block">
      <Label left="(02) Antes / después" right="Arrastra" />
      <BeforeAfter before={d.before} after={d.after} />
    </section>

    <section class="block">
      <Label left="(03) Reto y solución" right={`${d.blocks.length} claves`} />
      <ol class="rs">
        {d.blocks.map((b, i) => (
          <li>
            <span class="n mono">{pad(i + 1)}</span>
            <div><h2 class="mono k">Reto</h2><p>{b.challenge}</p></div>
            <div><h2 class="mono k">Solución</h2><p>{b.solution}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="block">
      <Label left="(04) Pantallas" right="Escritorio · Móvil" />
      <div class="screens">
        {d.screens.desktop.map((s) => (
          <Image class="desk" src={s.src} alt={s.alt} widths={[640, 1100, 1600]} sizes="(min-width: 860px) 62vw, 100vw" loading="lazy" />
        ))}
        <div class="phones">
          {d.screens.mobile.map((s) => (
            <Image class="phone" src={s.src} alt={s.alt} widths={[260, 390, 780]} sizes="(min-width: 860px) 16vw, 44vw" loading="lazy" />
          ))}
        </div>
      </div>
      <p class="visit">
        {d.url
          ? <a class="pill" href={d.url} target="_blank" rel="noopener">Ver la web ↗</a>
          : <a class="pill" href={whatsappUrl} target="_blank" rel="noopener">¿Quieres algo así? Escríbeme</a>}
      </p>
    </section>

    {next.id !== project.id && (
      <a class="next" href={`/trabajos/${next.id}/`}>
        <span class="mono nl">Siguiente proyecto</span>
        <span class="d nt">{next.data.title}</span>
        <Image class="nimg" src={next.data.cover} alt="" width={360} densities={[1, 2]} loading="lazy" transition:name={`cover-${next.id}`} />
      </a>
    )}
  </main>
  <Footer />
</Base>

<style>
  .case{padding:0 var(--pad)}
  .head{padding:6vh 0 4vh}
  .back{color:var(--mute);display:inline-block;margin-bottom:4vh}
  .back:hover{color:var(--ink)}
  h1{font-size:clamp(56px,12vw,200px);line-height:.85}
  .meta{display:flex;flex-wrap:wrap;gap:12px 40px;margin-top:4vh;border-top:1px solid var(--line);padding-top:14px}
  .meta dt{color:var(--mute);margin-bottom:4px}
  .tag{border:1px solid var(--ink);border-radius:999px;padding:3px 8px}
  .tag.real{background:var(--ink);color:var(--bg)}
  .cover{width:100%;height:min(70svh,760px);object-fit:cover;border-radius:10px}
  .intro,.block{padding-top:14vh}
  .lead{font-size:clamp(24px,3.2vw,46px);line-height:1.12;letter-spacing:-.03em;font-weight:500;max-width:24ch}
  .note{color:var(--mute);margin-top:24px}
  .rs{list-style:none}
  .rs li{display:grid;grid-template-columns:1fr;gap:14px 40px;padding:28px 0;border-top:1px solid var(--line)}
  @media(min-width:860px){.rs li{grid-template-columns:80px 1fr 1fr}}
  .n{color:var(--acc)}
  .k{color:var(--mute);font-weight:400;margin-bottom:8px}
  .rs p{font-size:clamp(17px,1.6vw,22px);line-height:1.4;max-width:36ch}
  .screens{display:grid;gap:16px;align-items:start}
  @media(min-width:860px){.screens{grid-template-columns:2fr 1fr}}
  .desk{width:100%;border-radius:10px;border:1px solid var(--line)}
  .phones{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .phone{width:100%;border-radius:18px;border:1px solid var(--line)}
  .visit{margin-top:32px}
  .pill{display:inline-block;font-size:14px;font-weight:500;border:1px solid var(--ink);border-radius:999px;padding:11px 18px;transition:background .35s var(--ease),color .35s var(--ease)}
  .pill:hover{background:var(--ink);color:var(--bg)}
  .next{display:grid;grid-template-columns:1fr auto;align-items:end;gap:20px;margin-top:18vh;padding:28px 0 12vh;border-top:1px solid var(--line)}
  .nl{grid-column:1/-1;color:var(--mute)}
  .nt{font-size:clamp(48px,10vw,170px);line-height:.85;transition:transform .6s var(--ease)}
  .next:hover .nt{transform:translateX(14px)}
  .nimg{width:clamp(120px,22vw,300px);aspect-ratio:300/380;height:auto;object-fit:cover;border-radius:10px}
  @media(max-width:600px){.next{grid-template-columns:1fr}.nimg{width:100%;aspect-ratio:16/10}}
</style>
